NODE_ENV=development
PORT=8000
SESSION_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:8000
DB_PATH=.data/ruangdigital.sqlite

# Set only after creating the administrator in the Railway environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Midtrans: use sandbox credentials during testing, then production credentials.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Generate with: openssl rand -base64 32. Keep old versioned keys during rotation.
ACCESS_DATA_KEY_VERSION=v1
ACCESS_DATA_KEY=

# Resend HTTPS API works on Railway Trial/Hobby and is preferred for production.
RESEND_API_KEY=
RESEND_FROM=

# Optional SMTP fallback; Railway SMTP requires a Pro plan or above.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFICATION_EMAIL=
BACKUP_DIR=.data/backups
